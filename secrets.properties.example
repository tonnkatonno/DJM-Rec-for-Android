# Copy this file to secrets.properties (gitignored, never commit the real one) and fill in
# your own values. Missing/blank values just disable the corresponding integration -- the app
# still builds and runs fine without any of these.

# Google Cloud Console > APIs & Services > Credentials > Create Credentials > OAuth client ID
#   Application type: Android
#   Package name:     com.audiopro.djmrec
#   SHA-1:             (run `./gradlew signingReport`, use the SHA1 for the variant you build)
# This client type has NO client secret -- Google verifies the app via package name + SHA-1
# instead, so the Client ID itself is not sensitive. It's still kept out of git here so every
# dev/fork registers their own (an Android OAuth client is bound to one specific signing key).
GOOGLE_DRIVE_CLIENT_ID=

# SoundCloud for Developers (soundcloud.com/you/apps) > Your app > Client ID / Client Secret.
# Unlike the Google Android client above, the Client Secret here IS sensitive -- SoundCloud's
# OAuth is a classic web-style flow, not tied to an app-signing fingerprint.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
